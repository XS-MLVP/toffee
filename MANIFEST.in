include LICENSE README.md README.en.md CONTRIBUTING.md pyproject.toml mkdocs.yml requirements-docs.txt
include .github/native-dependencies.json
recursive-include src *.py *.html *.css
recursive-include scripts *.py
recursive-include tests *.py *.md
recursive-include docs *.md
recursive-include design *.md *.py
recursive-include benchmarks *.py *.md
recursive-include examples *.py *.md *.sh *.cpp
include examples/integration/cache/verification_plan.json
include examples/integration/e203/verification_plan.json
prune output
prune build
prune dist
prune site
global-exclude __pycache__ *.py[cod]
